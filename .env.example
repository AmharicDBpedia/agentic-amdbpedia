GROQ_API_KEY=replace_with_your_groq_key
# Confirmed live against Groq's current catalog on 2026-09-02 (the previous
# defaults, llama-3.1-8b-instant/llama-3.3-70b-versatile, were removed by
# Groq at some point and now 400/401). Re-check
# https://api.groq.com/openai/v1/models against your key if this goes stale.
GROQ_MODEL_FAST=qwen/qwen3.8-27b
GROQ_MODEL_REASONING=qwen/qwen3.8-27b
RETRIEVAL_CONFIDENCE_THRESHOLD=0.35
# Pipeline LLM (rerank, propose-from-scratch, select-among-suggestions).
# Tried in order: PREDICT_MODEL first (local Gemma 2 9B via Ollama -- run
# `docker compose up -d ollama` then
# `docker compose exec ollama ollama pull gemma2:9b`), then PREDICT_FALLBACK_MODEL
# whenever Ollama is unreachable or times out. Leave the fallback unset to
# use groq/<GROQ_MODEL_FAST> with GROQ_API_KEY above; set it to `none` to
# run local-only. Any LiteLLM model string works for either.
PREDICT_MODEL=gemma2
# PREDICT_FALLBACK_MODEL=groq/qwen/qwen3.8-27b
# Gemma 2 9B on CPU needs several seconds per answer, more on first load.
PREDICT_LLM_TIMEOUT_SECONDS=60
# Defaults to a local SQLite file if unset -- only set this to point at the
# docker-compose postgres service (or another real Postgres instance).
DATABASE_URL=postgresql+asyncpg://mapping_assistant:mapping_assistant@localhost:5435/mapping_assistant
# Publish is unavailable until both of these are set. Create a Bot Password
# at Special:BotPasswords on mappings.dbpedia.org -- never a real account
# password. MEDIAWIKI_BOT_USERNAME is the full "User@BotName" form.
MEDIAWIKI_BASE_URL=https://mappings.dbpedia.org
MEDIAWIKI_BOT_USERNAME=
MEDIAWIKI_BOT_PASSWORD=
