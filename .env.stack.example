# Copy to .env.stack and fill in. docker-compose.stack.yml reads from here.
# Only these two are required; everything else has sane defaults.

GEMINI_API_KEY=replace_with_your_gemini_key
GROQ_API_KEY=replace_with_your_groq_key

# Optional overrides -- leave commented to use image defaults.
# PREDICT_MODEL=gemma4
# PREDICT_FALLBACK_MODEL=groq/qwen/qwen3.8-27b
# GROQ_MODEL_FAST=qwen/qwen3.8-27b
# GROQ_MODEL_REASONING=qwen/qwen3.8-27b
# PUBLIC_CROSS_LINGUAL_URL=http://localhost:8001
